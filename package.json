    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
